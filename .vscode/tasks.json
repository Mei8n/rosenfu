{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rosenfu: prepare dependencies",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/ensure-dependencies.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Rosenfu: build debug desktop",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "tauri",
        "--",
        "build",
        "--debug",
        "--no-bundle"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "dependsOn": [
        "Rosenfu: prepare dependencies"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Rosenfu: build release desktop",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "tauri",
        "--",
        "build",
        "--no-bundle"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "Rosenfu: prepare dependencies"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Rosenfu: dev (hot reload)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "tauri",
        "--",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "dependsOn": [
        "Rosenfu: prepare dependencies"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Rosenfu: test frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Rosenfu: test Rust",
      "type": "shell",
      "command": "cargo",
      "args": [
        "test",
        "--locked",
        "--workspace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Rosenfu: test all",
      "dependsOn": [
        "Rosenfu: test frontend",
        "Rosenfu: test Rust"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Rosenfu: check Rust formatting",
      "type": "shell",
      "command": "cargo",
      "args": [
        "fmt",
        "--all",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Rosenfu: build native dev",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--locked",
        "-p",
        "rosenfu-desktop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "Rosenfu: prepare dependencies"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Rosenfu: stop debug UI",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/debug-dev-server.mjs",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Rosenfu: debug UI",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/debug-dev-server.mjs",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "rosenfu-dev",
        "pattern": {
          "regexp": "^(.*):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^ROSENFU_DEV_STARTING$",
          "endsPattern": "^ROSENFU_DEV_READY$"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Rosenfu: prepare dev debug",
      "dependsOn": [
        "Rosenfu: stop debug UI",
        "Rosenfu: build native dev",
        "Rosenfu: debug UI"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
